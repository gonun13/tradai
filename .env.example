# Copy to .env for local overrides.
TRADAI_DATA_DIR=/data
WORKER_HEARTBEAT_SECONDS=30
# Compose currently runs quote refreshes every 900 seconds.
WORKER_QUOTE_INTERVAL_SECONDS=900

# US quotes/bars (free personal key from https://finnhub.io)
FINNHUB_API_KEY=

# Fundamentals: US primary; EU fallback when the active FMP plan covers the listing.
FMP_API_KEY=

# News (free personal token from https://www.marketaux.com)
MARKETAUX_API_TOKEN=

# Compatibility only: the unimplemented stub is never included in active routing.
IBKR_ENABLED=0

# Optional provider pacing/quota overrides. Defaults are conservative and state is persisted.
# FINNHUB_MIN_INTERVAL_SECONDS=1.05
# FINNHUB_RATE_WINDOW_LIMIT=60
# FMP_RATE_WINDOW_SECONDS=86400
# FMP_RATE_WINDOW_LIMIT=250
# MARKETAUX_RATE_WINDOW_SECONDS=86400
# MARKETAUX_RATE_WINDOW_LIMIT=100

# Claude Agent CLI (subscription). On the host: `claude setup-token`
# Do NOT set ANTHROPIC_API_KEY (it switches billing to pay-as-you-go).
CLAUDE_CODE_OAUTH_TOKEN=
# Optional CLI overrides.
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_TIMEOUT_SECONDS=300

# TypeSafe Jev (System One) for typed buy/sell/hold/watch decisions
# https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional adapter overrides.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_TIMEOUT_SECONDS=60

# Token thrift (defaults save Claude/Jev calls)
# One successful advisory per day is enough; SQLite caches research + recs + transcripts.
ADVISORY_INTERVAL_SECONDS=86400
# Extra Claude↔Jev scenario rounds after the four-lens pass (0 = skip; 3 = full 0009 loop)
ADVISORY_MAX_SCENARIO_ROUNDS=0

# Daily advisory after US regular close (America/New_York)
# Fire at 16:00 ET + this many minutes (default 30 → 16:30 ET). See spec/decisions/0011.
ADVISORY_AFTER_US_CLOSE_MINUTES=30
# How often the worker checks the schedule window (seconds)
ADVISORY_SCHEDULE_CHECK_SECONDS=60
